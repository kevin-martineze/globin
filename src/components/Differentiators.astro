---
import Section from './Section.astro';
import { differentiators } from '../data/differentiators';
import { sectionIntros } from '../data/copy';

/**
 * Five claims as full-width rows rather than cards: they are sentences, not
 * items, and a row lets the type stay large enough to be read as a statement.
 * The accent rule on the left grows on hover — the only movement in the
 * section, so it stays legible as a pointer rather than as decoration.
 */
---

<Section
  id="diferenciadores"
  label="Compromisos"
  title="Tecnología bien pensada,<br />comunicación clara"
  intro={sectionIntros.differentiators}
>
  <ul class="border-t hairline">
    {
      differentiators.map((item, index) => (
        <li class="group border-b hairline" data-reveal data-reveal-delay={index * 0.05}>
          <div class="relative grid gap-4 py-8 lg:grid-cols-12 lg:gap-10 lg:py-10">
            <span
              class="absolute top-0 -left-[var(--gutter)] hidden h-full w-px bg-brand-accent/0 transition-colors duration-500 group-hover:bg-brand-accent/60 lg:block"
              aria-hidden="true"
            />

            <div class="flex items-baseline gap-5 lg:col-span-5">
              <span class="font-mono text-xs text-brand-accent/70">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="display-tight text-[clamp(1.4rem,2.4vw,2.1rem)] text-bone">
                {item.title}
              </h3>
            </div>

            <p class="text-sm leading-relaxed text-muted lg:col-span-7 lg:text-base">
              {item.body}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
