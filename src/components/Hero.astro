---
import Dual from './Dual.astro';
import { site, whatsappLink } from '../data/site';
import { hero } from '../data/copy';

/**
 * Hero.
 *
 * The backdrop is built, not shot — there is no photography and none is coming.
 * What it is built from matters, though: the first version used a centred glow
 * plus a scattered node mesh, which is the exact backdrop every AI image
 * generator produces and every dark SaaS template ships. Recognisable as a
 * genre, not as Globin.
 *
 * This one draws the logo instead. The mark is a sphere with two ribbons
 * orbiting it and ending in arrowheads; the backdrop is those orbits at
 * architectural scale, tilted into perspective and turning slowly in opposite
 * directions. Same idea, brand-specific geometry — nothing about it could be
 * dropped onto another company's site.
 *
 * The other change is the grid: column rules rather than graph paper. Twelve
 * verticals read as a layout structure, which is what a designed page has, and
 * they line up with the type instead of sitting behind it as texture.
 *
 * motion.ts scales `[data-hero-media]` and darkens `[data-hero-veil]` on
 * scroll; if art direction ever supplies an image or a loop, it drops inside
 * the media element and neither has to change.
 */
const whatsapp = whatsappLink('Hola Globin, quiero contarles sobre mi proyecto.');
---

<section
  data-hero
  class="grain relative flex min-h-[92svh] items-end overflow-hidden pt-36 pb-16 lg:min-h-screen lg:pb-24"
>
  <div data-hero-media class="pointer-events-none absolute inset-0 -z-20">
    <!-- Brand wash anchored off-canvas at the top-left corner. Off-canvas is the
         point: a gradient whose centre you can find reads as a glow, and a glow
         is the tell. -->
    <div
      class="absolute inset-0 bg-[radial-gradient(125%_105%_at_-12%_-18%,var(--color-brand-mid)_0%,var(--color-brand-core)_28%,transparent_62%)]"
    >
    </div>

    <!-- Twelve column rules, aligned to the shell so they land on the type. -->
    <div class="column-rules mask-fade-b absolute inset-0"></div>

    <!-- Orbits: the logo's two ribbons at architectural scale. -->
    {/* Parked in the upper right. The section is bottom-aligned, so the
        headline occupies the lower left — the orbits stay out of its way
        instead of crossing the type. */}
    <svg
      class="orbits absolute top-[2%] right-[-16%] h-[62%] w-[82%] opacity-80 lg:right-[-7%] lg:h-[76%] lg:w-[48%] lg:opacity-100"
      viewBox="0 0 100 100"
      fill="none"
      aria-hidden="true"
    >
      <defs>
        <marker
          id="orbit-arrow-teal"
          viewBox="0 0 10 10"
          refX="6"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M0 1.5 L8 5 L0 8.5 z" fill="currentColor" class="text-brand-accent" />
        </marker>
        <marker
          id="orbit-arrow-bone"
          viewBox="0 0 10 10"
          refX="6"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M0 1.5 L8 5 L0 8.5 z" fill="currentColor" class="text-bone/45" />
        </marker>
      </defs>

      <!-- The sphere the ribbons wrap: a hairline, never a filled shape. -->
      <circle cx="50" cy="50" r="30" class="stroke-bone/[0.07]" stroke-width="0.25" />
      <circle cx="50" cy="50" r="44" class="stroke-bone/[0.04]" stroke-width="0.25" />

      {/* Each orbit is tilted by a static outer group and turned by an inner one,
          so the perspective holds still while the ribbon travels around it. */}
      <g class="tilt-a">
        <g class="spin-a">
          <path
            d="M 80 50 A 30 30 0 1 1 34.6 24.0"
            class="stroke-brand-accent/55"
            stroke-width="0.5"
            stroke-linecap="round"
            marker-end="url(#orbit-arrow-teal)"
          />
        </g>
      </g>

      <g class="tilt-b">
        <g class="spin-b">
          <path
            d="M 20 50 A 30 30 0 1 1 65.4 76.0"
            class="stroke-bone/25"
            stroke-width="0.4"
            stroke-linecap="round"
            marker-end="url(#orbit-arrow-bone)"
          />
        </g>
      </g>
    </svg>
  </div>

  <!-- Veil sits between backdrop and copy; motion.ts drives it to 0.9 on scroll
       so the headline stays legible as the section leaves. -->
  <div
    data-hero-veil
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/55 to-transparent opacity-70"
  >
  </div>

  <div class="shell">
    <div class="max-w-4xl">
      <p class="eyebrow mb-7 flex flex-wrap items-center gap-3" data-reveal="fade">
        <span class="inline-block size-1.5 rounded-full bg-brand-accent"></span>
        Software y soluciones tecnológicas
        <span class="text-bone/25">/</span>
        Clientes en cualquier país
      </p>

      {/* No `data-split` on dual copy: SplitText would measure the hidden
          version too and leave a stack of empty masked lines behind the visible
          one. The wrapper carries the reveal instead. */}
      {/* One `<h1>` with both versions inside it, rather than two headings: the
          hidden one is out of the accessibility tree either way, but a crawler
          reading the source should still find a single top-level heading. */}
      <h1
        class="display text-glow max-w-[15ch] text-[clamp(2.4rem,6.4vw,5.6rem)] text-bone"
        data-reveal="fade"
      >
        <Dual text={hero.headline} />
      </h1>

      <div data-reveal data-reveal-delay="0.1">
        <Dual
          text={hero.standfirst}
          as="p"
          class="mt-9 max-w-2xl text-lg leading-relaxed text-muted"
        />
      </div>

      <div class="mt-11 flex flex-wrap gap-4" data-reveal data-reveal-delay="0.2">
        <a
          href={site.ctaHref}
          class="group relative overflow-hidden rounded-full bg-brand-accent px-7 py-4 text-sm font-medium text-ink-950"
        >
          <span
            class="absolute inset-0 -translate-y-full bg-bone transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
          ></span>
          <span class="relative">{site.cta}</span>
        </a>

        {/* The secondary CTA is WhatsApp when a number exists. Until it does, the
            brief's informative CTA takes the slot rather than a dead button. */}
        {
          whatsapp ? (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener"
              class="rounded-full border hairline px-7 py-4 text-sm text-bone transition-colors duration-300 hover:border-bone"
            >
              {site.ctaSecondary}
            </a>
          ) : (
            <a
              href="#servicios"
              class="rounded-full border hairline px-7 py-4 text-sm text-bone transition-colors duration-300 hover:border-bone"
            >
              Conocer nuestros servicios
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute right-[var(--gutter)] bottom-10 hidden items-center gap-3 lg:flex"
    aria-hidden="true"
  >
    <span class="eyebrow">{site.tagline}</span>
    <span class="block h-12 w-px bg-gradient-to-b from-brand-accent/60 to-transparent"></span>
  </div>
</section>

<style>
  /* Twelve columns matching `.shell`, so the rules fall between the words
     instead of across them. `background-size` does the division: percentages in
     a repeating gradient would repeat over the element, not the container. */
  .column-rules {
    --cols: 12;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    background-image: linear-gradient(
      to right,
      color-mix(in oklab, var(--color-bone) 7%, transparent) 1px,
      transparent 1px
    );
    background-size: calc(100% / var(--cols)) 100%;
    /* Both, and in this order: `origin` makes the 1/12 division measure the
       content box (the same width `.shell` gives the type), `clip` stops the
       rules bleeding into the gutter. Clip alone would size off the padding box
       and the columns would drift out of step with the layout. */
    background-origin: content-box;
    background-clip: content-box;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    /* Twelve rules on a phone is hatching, not structure. */
    .column-rules {
      --cols: 4;
    }
  }

  /* The orbits. Tilt is static; only the inner group turns, which is what makes
     the ribbon look like it is travelling around a sphere rather than a flat
     circle spinning in place.

     `transform-box: view-box` is required for the rotation to happen around the
     viewBox centre instead of the path's own bounding box. */
  .orbits g {
    transform-box: view-box;
    transform-origin: 50px 50px;
  }

  .tilt-a {
    transform: rotate(-24deg) scaleY(0.46);
  }
  .tilt-b {
    transform: rotate(28deg) scaleY(0.38);
  }

  /* Slow enough to be noticed only on a second look. Two speeds and two
     directions, so the pair never falls into step and starts reading as a
     loading spinner. */
  .spin-a {
    animation: orbit 68s linear infinite;
  }
  .spin-b {
    animation: orbit 96s linear infinite reverse;
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  /* The global reduced-motion rule collapses animation duration to ~0, which
     freezes these mid-turn — fine, since the still frame is the composition. */
</style>
