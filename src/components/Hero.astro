---
import { Image } from 'astro:assets';
import { site, whatsappLink } from '../data/site';
import { textures } from '../data/media';

/**
 * Hero.
 *
 * The backdrop is layered: the brand gradient underneath, the generated ribbon
 * render over it, the engineering grid, then grain. The render carries its own
 * node network, which is why the hand-drawn SVG graph that used to live here is
 * gone — two versions of the same motif on top of each other read as noise, not
 * as depth.
 *
 * The image's left side is empty by design, so the headline sits on the
 * gradient rather than on ribbons. That is also the fallback if the image ever
 * fails to load: the gradient alone still reads.
 *
 * motion.ts scales `[data-hero-media]` and darkens `[data-hero-veil]` on
 * scroll; neither cares what is inside.
 */
const whatsapp = whatsappLink('Hola Globin, quiero contarles sobre mi proyecto.');
---

<section
  data-hero
  class="grain relative flex min-h-[92svh] items-end overflow-hidden pt-36 pb-16 lg:min-h-screen lg:pb-24"
>
  <div data-hero-media class="pointer-events-none absolute inset-0 -z-20">
    {/* Fallback layer. If the render never loads, the gradient alone still
        reads as a designed hero rather than as a black rectangle. */}
    <div
      class="size-full bg-[radial-gradient(110%_85%_at_15%_-10%,var(--color-brand-mid)_0%,var(--color-brand-core)_34%,var(--color-ink-950)_72%)]"
    >
    </div>

    {/* No blend mode: `screen` was tried and it lifted the render's blacks and
        turned the silver ribbons grey-green. The render's own background is
        already ink-dark, so it just sits there. Eager and high priority —
        this is the LCP element of the page. */}
    <Image
      src={textures.heroRibbons.src}
      alt=""
      aria-hidden="true"
      widths={[768, 1100, 1376]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover object-right"
    />

    {/* Brand tint in the empty corner, where the headline lands: it keeps the
        top-left from going flat black now that the gradient is covered. */}
    <div
      class="absolute inset-0 bg-[radial-gradient(70%_80%_at_10%_0%,color-mix(in_oklab,var(--color-brand-mid)_55%,transparent)_0%,transparent_70%)]"
    >
    </div>
  </div>

  {/* Veils sit outside `[data-hero-media]` so they hold still while the render
      drifts under them on scroll. The side one is what guarantees headline
      contrast; without it the type would depend on wherever the ribbons
      happen to fall at a given viewport width. */}
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/95 via-ink-950/70 to-transparent"
  >
  </div>

  <!-- motion.ts drives this one to 0.9 on scroll, so the headline stays
       legible as the section leaves. -->
  <div
    data-hero-veil
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/45 to-transparent opacity-70"
  >
  </div>

  <div class="shell">
    <div class="max-w-4xl">
      <p class="eyebrow mb-7 flex flex-wrap items-center gap-3" data-reveal="fade">
        <span class="inline-block size-1.5 rounded-full bg-brand-accent"></span>
        Software y soluciones tecnológicas
        <span class="text-bone/25">/</span>
        Clientes en cualquier país
      </p>

      <h1 class="display text-glow text-[clamp(2.6rem,7.4vw,6.6rem)] text-bone" data-split>
        Soluciones digitales<br />con <span class="text-brand-accent">ingenio</span> para<br />
        hacer crecer tu negocio
      </h1>

      <p
        class="mt-9 max-w-2xl text-lg leading-relaxed text-muted"
        data-reveal
        data-reveal-delay="0.1"
      >
        En Globin diseñamos y desarrollamos software, aplicaciones móviles,
        automatizaciones y soluciones cloud adaptadas a las necesidades reales de tu empresa.
      </p>

      <div class="mt-11 flex flex-wrap gap-4" data-reveal data-reveal-delay="0.2">
        <a
          href={site.ctaHref}
          class="group relative overflow-hidden rounded-full bg-brand-accent px-7 py-4 text-sm font-medium text-ink-950"
        >
          <span
            class="absolute inset-0 -translate-y-full bg-bone transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0"
          ></span>
          <span class="relative">{site.cta}</span>
        </a>

        {/* The secondary CTA is WhatsApp when a number exists. Until it does, the
            brief's informative CTA takes the slot rather than a dead button. */}
        {
          whatsapp ? (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener"
              class="rounded-full border hairline px-7 py-4 text-sm text-bone transition-colors duration-300 hover:border-bone"
            >
              {site.ctaSecondary}
            </a>
          ) : (
            <a
              href="#servicios"
              class="rounded-full border hairline px-7 py-4 text-sm text-bone transition-colors duration-300 hover:border-bone"
            >
              Conocer nuestros servicios
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute right-[var(--gutter)] bottom-10 hidden items-center gap-3 lg:flex"
    aria-hidden="true"
  >
    <span class="eyebrow">{site.tagline}</span>
    <span class="block h-12 w-px bg-gradient-to-b from-brand-accent/60 to-transparent"></span>
  </div>
</section>

