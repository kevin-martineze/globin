---
/**
 * The section shell.
 *
 * The numbered eyebrow that used to open every block is gone — the fixed index
 * rail carries the running order now, and printing it twice was the loudest
 * thing this layout had borrowed from elsewhere.
 *
 * What replaces it is the grid: a narrow label column and a wide content
 * column, offset from each other. Headings sit in the wide column and the label
 * hangs in the margin beside them, which is how a reference book sets a
 * section and not how a landing template does.
 */
interface Props {
  /** Anchor target. Must match an entry in `sections` (data/site.ts). */
  id: string;
  /** Margin label — a noun, not a sentence. */
  label: string;
  /** Headline. `<br />` allowed; SplitText animates per line. */
  title?: string;
  /** Optional standfirst. */
  intro?: string;
  /** Vertical rhythm. `tight` for stacked sections that belong together. */
  space?: 'default' | 'tight';
  class?: string;
}

const { id, label, title, intro, space = 'default', class: className } = Astro.props;
---

<section
  id={id}
  class:list={['relative', space === 'tight' ? 'py-16 lg:py-24' : 'py-24 lg:py-36', className]}
>
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">
      <p class="eyebrow lg:col-span-3 lg:pt-3" data-reveal="fade">{label}</p>

      <div class="lg:col-span-9">
        {
          title && (
            <h2
              class="display max-w-[18ch] text-[clamp(2.1rem,4.6vw,4.2rem)] text-bone"
              data-split
              set:html={title}
            />
          )
        }
        {
          intro && (
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted" data-reveal>
              {intro}
            </p>
          )
        }
      </div>
    </div>

    <div class="mt-14 lg:mt-16">
      <slot />
    </div>
  </div>
</section>
