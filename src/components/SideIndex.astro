---
import { sections } from '../data/site';

/**
 * Fixed index rail, desktop only.
 *
 * It replaces the numbered eyebrow that used to sit inside every section. The
 * difference is not cosmetic: a number printed in a heading tells you what you
 * are looking at, while a rail tells you where you are in the whole document
 * and how much is left — which is what a long single-page site actually needs.
 *
 * Below 1280px it is hidden rather than reflowed. There is no room for a
 * persistent rail on a laptop-narrow window, and a collapsed version of it
 * would just be the header menu again.
 */
---

<nav data-side-index class="side-index" aria-label="Índice de secciones">
  <ol>
    {
      sections.map((section, index) => (
        <li>
          <a href={section.href} data-index-link={section.href}>
            <span class="n">{String(index + 1).padStart(2, '0')}</span>
            <span class="dash" aria-hidden="true" />
            <span class="label">{section.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .side-index {
    display: none;
  }

  @media (min-width: 1280px) {
    .side-index {
      position: fixed;
      top: 50%;
      left: max(1.5rem, calc((100vw - 96rem) / 2 + 1.5rem));
      z-index: 40;
      display: block;
      transform: translateY(-50%);
    }
  }

  .side-index ol {
    display: grid;
    gap: 0.55rem;
  }

  .side-index a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-bone) 28%, transparent);
    transition: color 0.35s var(--ease-out-expo);
  }

  .n {
    font-variant-numeric: tabular-nums;
  }

  /* The dash grows on the active item. It is the only indicator, which keeps
     the rail readable as a scale rather than as a menu. */
  .dash {
    display: block;
    width: 0.75rem;
    height: 1px;
    background: currentColor;
    transition:
      width 0.45s var(--ease-out-expo),
      background-color 0.35s;
  }

  /* Labels stay out of the way until the rail is being used. */
  .label {
    opacity: 0;
    transform: translateX(-0.25rem);
    transition:
      opacity 0.35s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
  }

  .side-index:hover .label,
  .side-index a:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  .side-index a:hover {
    color: var(--color-bone);
  }

  .side-index a[aria-current='true'] {
    color: var(--color-brand-accent);
  }

  .side-index a[aria-current='true'] .dash {
    width: 2rem;
  }

  .side-index a[aria-current='true'] .label {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const links = new Map<string, HTMLAnchorElement>();

  document.querySelectorAll<HTMLAnchorElement>('[data-index-link]').forEach((link) => {
    const id = link.dataset.indexLink;
    if (id) links.set(id.replace('#', ''), link);
  });

  if (links.size > 0) {
    const setActive = (id: string) => {
      links.forEach((link, key) => {
        if (key === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    /**
     * A band across the upper third of the viewport decides the active section,
     * rather than "whatever is most visible": with sections this tall, the
     * most-visible rule leaves the rail lagging a whole screen behind what you
     * are reading.
     */
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      { rootMargin: '-12% 0px -72% 0px', threshold: 0 },
    );

    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
</script>
