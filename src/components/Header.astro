---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import { brand } from '../data/media';
import RegisterToggle from './RegisterToggle.astro';

const hasNav = nav.length > 0;
const hasCta = Boolean(site.cta && site.ctaHref);
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500"
>
  <div class="shell flex items-center justify-between gap-6 py-5">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} — inicio`}>
      {/* The link already names itself with aria-label, so both the mark and the
          wordmark are decorative here — otherwise a screen reader announces the
          brand name three times over. */}
      <Image
        src={brand.mark.src}
        alt=""
        aria-hidden="true"
        widths={[44, 88]}
        sizes="44px"
        loading="eager"
        class="size-11 shrink-0 object-contain"
      />
      <span
        class="display-tight text-base leading-[1.15] tracking-[0.14em] text-bone"
        aria-hidden="true"
      >
        {site.name}
      </span>
    </a>

    {
      hasNav && (
        <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
          {nav.map((item) => (
            <a
              href={item.href}
              class="relative text-sm text-muted transition-colors duration-300 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-brand-accent after:transition-[width] after:duration-500 hover:text-bone hover:after:w-full"
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="flex items-center gap-3">
      {/* The switch sits next to the primary action, not buried in the menu:
          it is the first thing the page offers, and hiding it would make it a
          feature nobody finds. */}
      <div class="hidden sm:block">
        <RegisterToggle />
      </div>

      {
        hasCta && (
          <a
            href={site.ctaHref}
            class="group relative hidden overflow-hidden rounded-full bg-bone px-5 py-2.5 text-sm font-medium text-ink-950 sm:block"
          >
            {/* The fill wipes down from above on hover — the one flourish the
                header gets, so it stays on the primary action only. */}
            <span class="absolute inset-0 -translate-y-full bg-brand-accent transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0" />
            <span class="relative transition-colors duration-300 group-hover:text-bone">
              {site.cta}
            </span>
          </a>
        )
      }

      {
        hasNav && (
          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="menu-movil"
            class="flex size-11 items-center justify-center rounded-full border hairline lg:hidden"
          >
            <span class="sr-only">Abrir menú</span>
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
              <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        )
      }
    </div>
  </div>

  {
    hasNav && (
      <div
        id="menu-movil"
        data-menu-panel
        hidden
        class="border-t hairline bg-ink-950/95 backdrop-blur-xl lg:hidden"
      >
        <div class="shell flex flex-col py-4">
          <div class="border-b hairline pb-4 sm:hidden">
            <RegisterToggle />
          </div>
          <nav aria-label="Menú móvil" class="flex flex-col">
            {nav.map((item) => (
              <a href={item.href} class="border-b hairline py-4 text-lg text-bone last:border-0">
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    )
  }
</header>

<style>
  /* Applied by motion.ts once you scroll past the hero. Kept in CSS so the
     header still reads correctly if JavaScript never boots. */
  [data-header].is-stuck {
    background-color: color-mix(in oklab, var(--color-ink-950) 72%, transparent);
    backdrop-filter: blur(18px) saturate(1.2);
    border-bottom: 1px solid var(--edge);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  panel?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    }),
  );
</script>
