---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { brand } from '../data/media';
import { useContent, toLang } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = useContent(lang);

const year = new Date().getFullYear();

// Contact rows are built from whatever the brief has supplied. Anything still
// empty is dropped rather than rendered as a blank line.
const socials = [
  { label: 'Instagram', href: site.social.instagram, handle: site.handles.instagram },
  { label: 'LinkedIn', href: site.social.linkedin, handle: site.handles.linkedin },
  { label: 'GitHub', href: site.social.github, handle: site.handles.github },
].filter((item) => Boolean(item.href));
---

<footer class="border-t hairline bg-ink-950 pt-16 pb-10">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <Image
            src={brand.mark.src}
            alt=""
            aria-hidden="true"
            widths={[56, 112]}
            sizes="56px"
            loading="lazy"
            class="size-14 shrink-0 object-contain"
          />
          <span class="display-tight text-lg leading-[1.15] text-bone">{site.name}</span>
        </div>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">{t.meta.description}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">{t.closing.coverage}</p>
      </div>

      <nav aria-label={t.footer.navLabel} class="lg:col-span-3">
        <p class="eyebrow mb-5">{t.footer.navLabel}</p>
        <ul class="space-y-3">
          {
            t.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-bone/80 transition-colors duration-300 hover:text-brand-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <p class="eyebrow mb-5">{t.footer.contactLabel}</p>
        <ul class="space-y-3 text-sm text-bone/80">
          {
            site.phone && (
              <li>
                <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-brand-accent">
                  {site.phone}
                </a>
              </li>
            )
          }
          {
            site.email && (
              <li>
                <a href={`mailto:${site.email}`} class="hover:text-brand-accent">
                  {site.email}
                </a>
              </li>
            )
          }
          <li class="text-muted">{site.country}</li>
        </ul>

        {
          socials.length > 0 && (
            <ul class="mt-6 space-y-3">
              {socials.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener"
                    class="text-sm text-bone/80 hover:text-brand-accent"
                  >
                    {item.label}
                    {item.handle && <span class="text-muted"> {item.handle}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t hairline pt-6 text-xs text-muted"
    >
      <p>© {year} {site.name}. {t.footer.rights}</p>
      <p>{t.meta.tagline}</p>
    </div>
  </div>
</footer>
