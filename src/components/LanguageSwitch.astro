---
import { toLang, otherLang, localePath, useContent } from '../i18n';

/**
 * Two-language switch, set as the pair of ISO codes with the current one lit.
 *
 * Showing both is what makes it readable at a glance: a control that says only
 * "English" leaves the visitor working out whether that is the state or the
 * action. The codes need no translation, so nothing here is copy — the words
 * live in `language`, and they are what the link announces to a screen reader.
 *
 * It is still a plain link to the other language's page, not a script: it works
 * before hydration, it is crawlable, and it cannot desync from the route the way
 * a scripted toggle can.
 *
 * Clicking it records the choice, which is what stops the first-visit
 * auto-redirect in Layout.astro from ever overriding a deliberate decision.
 * That guarantee is the reason the switch must always be visible — the brief's
 * markets are Colombia *and* abroad, and guessing wrong without an escape hatch
 * is worse than not guessing.
 */
const lang = toLang(Astro.currentLocale);
const target = otherLang(lang);
const t = useContent(lang);
---

<div class="flex items-center gap-2 font-mono text-[0.68rem] tracking-[0.14em] uppercase">
  <span class="text-bone" aria-current="true">{lang}</span>
  <span class="text-bone/25" aria-hidden="true">·</span>
  <a
    data-lang-switch={target}
    href={localePath(target)}
    hreflang={target}
    aria-label={`${t.language.label}: ${t.language.switchTo}`}
    class="text-muted transition-colors duration-300 hover:text-bone"
  >
    {target}
  </a>
</div>

<script>
  const KEY = 'globin:lang';

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, link.dataset.langSwitch ?? 'es');
      } catch {
        // Storage blocked: the navigation still happens, the preference just is
        // not remembered. Never worth cancelling the click over.
      }
    });
  });
</script>
