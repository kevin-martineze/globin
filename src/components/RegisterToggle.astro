---
import { registers } from '../data/dual';

/**
 * The switch that rewrites the page.
 *
 * It is a radio group, not two buttons: the two registers are one exclusive
 * choice, and radios give keyboard arrow navigation and the right announcement
 * for free. The visible pill is the label; the input itself is visually hidden
 * but still focusable, so the focus ring lands where it should.
 *
 * The choice is remembered in localStorage and re-applied before first paint by
 * the inline script in Layout.astro — a switch that forgets is worse than no
 * switch, and one that flashes the wrong text on every page load is worse still.
 */
---

<fieldset data-register-toggle class="register">
  <legend class="sr-only">Cómo quieres leer la página</legend>

  <span class="thumb" aria-hidden="true"></span>

  {
    registers.map((register, index) => (
      <label>
        <input
          type="radio"
          name="register"
          value={register.id}
          checked={index === 0}
          class="sr-only"
        />
        <span>{register.label}</span>
      </label>
    ))
  }
</fieldset>

<style>
  .register {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.2rem;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink-900) 70%, transparent);
    backdrop-filter: blur(12px);
  }

  .register label {
    position: relative;
    z-index: 1;
    cursor: pointer;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.3s var(--ease-out-expo);
    white-space: nowrap;
  }

  .register label:has(:checked) {
    color: var(--color-ink-950);
  }

  .register:hover label:not(:has(:checked)) {
    color: var(--color-bone);
  }

  /* One pill that slides, rather than two that light up: the movement is what
     tells you the two options are the same text in two voices. */
  .thumb {
    position: absolute;
    z-index: 0;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0.2rem;
    width: calc(50% - 0.2rem);
    border-radius: 999px;
    background: var(--color-brand-accent);
    transition: transform 0.42s var(--ease-out-expo);
  }

  .register:has(label:last-of-type :checked) .thumb {
    transform: translateX(100%);
  }

  .register label:has(:focus-visible) {
    outline: 2px solid var(--color-brand-accent-bright);
    outline-offset: 3px;
    border-radius: 999px;
  }
</style>

<script>
  const KEY = 'globin:register';

  /**
   * Every toggle on the page shares one state — there are two of them (header
   * and mobile menu) and they must never disagree.
   */
  function apply(value: string, persist: boolean) {
    document.documentElement.dataset.register = value;

    document
      .querySelectorAll<HTMLInputElement>('[data-register-toggle] input')
      .forEach((input) => {
        input.checked = input.value === value;
      });

    if (persist) {
      try {
        localStorage.setItem(KEY, value);
      } catch {
        // Private mode or blocked storage: the switch still works for this
        // visit, it just will not be remembered. Not worth failing over.
      }
    }

    // Both registers are different lengths, so every scroll trigger measured
    // before the swap is now wrong. motion.ts listens for this.
    document.dispatchEvent(new CustomEvent('register:change', { detail: value }));
  }

  document.querySelectorAll<HTMLElement>('[data-register-toggle]').forEach((group) => {
    group.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input?.name === 'register') apply(input.value, true);
    });
  });

  // The inline script in the layout already set the attribute before paint;
  // this syncs the inputs to it.
  apply(document.documentElement.dataset.register ?? 'simple', false);
</script>
