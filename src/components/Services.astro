---
import Section from './Section.astro';
import { useContent, toLang } from '../i18n';

const t = useContent(toLang(Astro.currentLocale));

/**
 * Six services in an even three-column grid. The brief asks for uneven
 * prominence, which here is colour rather than size: the two featured cards get
 * the accent border and icon while every card keeps the same footprint. Spanning
 * cells instead would leave an orphan in the last row at six items.
 */

// Icons are 24x24, 1.5 stroke, drawn on the same grid so they read as a set.
const icons: Record<string, string> = {
  blocks:
    '<path d="M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3z"/><path d="M17 13v8M13 17h8"/>',
  device:
    '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10.5 18.5h3"/>',
  window:
    '<rect x="2.5" y="4" width="19" height="16" rx="2.5"/><path d="M2.5 9h19M6 6.5h.01M9 6.5h.01"/>',
  flow: '<circle cx="5" cy="6" r="2.5"/><circle cx="19" cy="12" r="2.5"/><circle cx="5" cy="18" r="2.5"/><path d="M7.5 6h5a4 4 0 0 1 4 4v.5M7.5 18h5a4 4 0 0 0 4-4v-.5"/>',
  cloud:
    '<path d="M7 18h10a4 4 0 0 0 .8-7.9A6 6 0 0 0 6.3 9.4 3.8 3.8 0 0 0 7 18Z"/><path d="M12 13.5v4M10 15.5l2-2 2 2"/>',
  pulse: '<path d="M2.5 12h4l2.5-6 4 12 2.5-6h6"/>',
};
---

<Section
  id="servicios"
  label={t.services.label}
  title={t.services.title}
  intro={t.services.intro}
>
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      t.services.items.map((service, index) => (
        <article
          id={service.id}
          data-reveal
          data-reveal-delay={index * 0.07}
          class:list={[
            'card group flex flex-col p-8',
            service.featured && 'border-brand-accent/40 bg-brand-accent/[0.06]',
          ]}
        >
          <span
            class:list={[
              'grid size-11 place-items-center rounded-xl border transition-colors duration-500',
              service.featured
                ? 'border-brand-accent/40 text-brand-accent'
                : 'hairline text-bone/70 group-hover:text-brand-accent',
            ]}
            aria-hidden="true"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[service.icon]}
            />
          </span>

          <h3 class="display-tight mt-7 text-2xl text-bone">{service.name}</h3>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{service.summary}</p>

          {/* The technical register, kept small and in mono: there for the
              reader who wants it, ignorable for the one who does not. */}
          <p class="mt-7 border-t hairline pt-5 font-mono text-[0.7rem] leading-relaxed tracking-wide text-bone/45">
            {service.detail}
          </p>
        </article>
      ))
    }
  </div>
</Section>
